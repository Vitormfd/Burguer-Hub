VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# URL pública canônica do produto (cardápio, WhatsApp, links compartilháveis).
# Em produção: https://easyfoodhub.com.br
# O domínio técnico burguer-hub.vercel.app pode continuar como backup.
VITE_PUBLIC_APP_URL="https://easyfoodhub.com.br"

# Pixel do Meta: o ID de produção está em src/lib/metaPixel.ts e só carrega em easyfoodhub.com.br.
# Preencha só para testar o pixel fora de produção (ex.: um pixel de teste).
VITE_META_PIXEL_ID=
